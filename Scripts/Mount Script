#!/bin/bash
# ======================================================================================
# SCRIPT: Rclone Heartbeat
# VERSION: v1.0-RC2.0.12
# DESCRIPTION: Monitors Rclone mounts
#               v2.0.12: VFS Cache pruning controlled by target utilisation
# ======================================================================================

# --------------------------------------------------------------------------------------
# 1. USER CONFIGURATION
# --------------------------------------------------------------------------------------

# --- SCRIPT SETTINGS ---
SCRIPT_VERSION="v1.0-RC2.0.12"
STATE_FILE="/mnt/user/appdata/other/scripts/rclone/prime_state.db"
LOG_FILE="/mnt/user/appdata/other/scripts/rclone/rclone_mount.log"

# --- REQUIRED SETTINGS ---
REMOTE_NAME="nzbdav:"                                                                           # Rclone remote name including colon
RCLONE_CONF="/boot/config/plugins/rclone/.rclone.conf"
MOUNT_PATH="/mnt/computers/streaming/nzbdav"                                                     # full path to where remote should be mounted
VFS_CACHE_DIR="/mnt/samsung/streaming_cache/nzbdav"                                            # Path for rclone cache files
VFS_CACHE_SIZE="150G"                                                                            # Maximum size of the VFS cache
CACHE_DRIVE_SIZE="250G"
CACHE_DRIVE_MAX_UTILISATION="85%"                                                               # Target max drive utilisation % oldest files deleted until utilisation under this number
VFS_CACHE_AGE="2d"
VFS_READ_AHEAD="1024M"
VFS_CHUNK_LIMIT="1024M"

VFS_MODE="full"                                                                                  # --vfs-cache-mode mode.
CHUNK_START="16M"                                                                                 # --vfs-read-chunk-size.
RAM_BUFFER="0M"                                                                                 # --buffer-size RAM buffer.
CACHE_TIME="1h"                                                                               # --dir-cache-time.

# --- OPTIONAL MOUNT SETTINGS ---
DECYPH_PATH="/mnt/computers/streaming/decypharr"                                                 # Location of your Decypharr mount
RC_IP="0.0.0.0"                                                                                  #
RC_PORT="5573"                                                                                   #
RC_USER="YOUR_USERNAME"   
RC_PASS="YOUR_PASSWORD"
CPU_PIN="12,13,14,15,28,29,30,31"                                                      

# --- DOCKER SETTINGS ---
NZBDAV_CONTAINER="nzbdav"
DECYPHAR_CONTAINER="Decypharr"
CONTAINERS="autopulse byparr prowlarr postgresql16 plex emby tautulli Seerr Wizarr radarr sonarr lidarr bookshelf bazarr posterizarr Kometa neutarr calibre2026 calibre-web"

# --------------------------------------------------------------------------------------
# 2. MAIN SCRIPT - DO NOT EDIT BELOW HERE!
# --------------------------------------------------------------------------------------

log_step() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"; } 

send_notification() {
    local subject="$1"
    local message="$2"
    local importance="$3" # normal or alert
    /usr/local/emhttp/webGui/scripts/notify -e "Rclone Heartbeat" -s "$subject" -d "$message" -i "$importance"
}

# --- SECTION 2.1: SUMMARY ---
log_step "VALIDATING: Script configuration and environment..."
log_step "---------------------------------------------------"
log_step "[CONFIG SUMMARY]"
log_step "Script Version:      $SCRIPT_VERSION"
log_step "Rclone Remote:       $REMOTE_NAME"
log_step "State File:          $STATE_FILE"
log_step ""
log_step "[RCLONE PERFORMANCE]"
log_step "VFS Mode:            $VFS_MODE"
log_step "VFS Read Ahead:      $VFS_READ_AHEAD"
log_step "RAM Buffer:          $RAM_BUFFER"
log_step "CHUNK START:         $CHUNK_START"
log_step ""
log_step "[DOCKER SETTINGS]"
log_step "NzbDAV Container:    $NZBDAV_CONTAINER"
log_step "Decypharr Container: $DECYPHAR_CONTAINER"
log_step "Other Containers:    $CONTAINERS"
log_step "---------------------------------------------------"

# --- SECTION 2.2: ENVIRONMENTAL READINESS ---
log_step "VERIFYING: System environment..."
mkdir -p "$(dirname "$STATE_FILE")"                                             
mkdir -p "$(dirname "$LOG_FILE")"
mkdir -p "$VFS_CACHE_DIR"

# --- SECTION 2.3: FOUNDATION CHECK ---
log_step "Ensuring Core services are active..."
for container in "$NZBDAV_CONTAINER" "$DECYPHAR_CONTAINER"; do
    if [[ -n "$container" ]]; then
        if [ "$(docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null)" != "true" ]; then
            log_step "Starting $container..."
            docker start "$container" > /dev/null 2>&1
        fi
    fi
done

# --- SECTION 2.4: NZBDAV MOUNT AUDIT ---
[ -f "$STATE_FILE" ] && source "$STATE_FILE"
VALIDATION_FILE="$MOUNT_PATH/README"

log_step "CHECKING: NzbDAV Mount integrity..."
NZB_MOUNT_ALIVE=false

# Check if process is running and mount is visible in system
if [ "$(docker inspect -f '{{.State.Running}}' "$NZBDAV_CONTAINER" 2>/dev/null)" == "true" ] && \
   grep -q "$MOUNT_PATH" /etc/mtab; then
    
    N_COUNT=0
    while [ $N_COUNT -lt 5 ]; do
        if timeout 5s ls "$VALIDATION_FILE" > /dev/null 2>&1; then
            NZB_MOUNT_ALIVE=true
            log_step "Passed: NzbDAV is UP."
            break
        fi
        log_step "WAITING: NzbDAV mount stalling (Attempt $((N_COUNT + 1))/5)..."
        sleep 6
        ((N_COUNT++))
    done
else
    log_step "[!] NzbDAV process/mount missing. Bypassing patience window..."
fi

# Update NzbDAV State
if [[ "$NZB_MOUNT_ALIVE" == "true" ]]; then
    if [[ "$NZB_STATE" != "UP" ]]; then
        NZB_STATE="UP"
        NZB_START_TS=$(date +%s)
    fi
else
    log_step "[!] Failed: NzbDAV is DOWN."
    send_notification "Mount Down" "NzbDAV mount failure at $MOUNT_PATH" "alert"
    if [[ "$NZB_STATE" != "DOWN" ]]; then
        NZB_STATE="DOWN"
        NZB_START_TS=$(date +%s)
    fi
fi

# --- SECTION 2.5: DECYPHARR MOUNT & UI AUDIT ---
DEC_MOUNT_ALIVE=false
DECYPHARR_PORT="8282"

if [[ -n "$DECYPH_PATH" ]] && [[ -n "$DECYPHAR_CONTAINER" ]]; then
    log_step "CHECKING: Decypharr Mount & UI responsiveness..."
    
    D_COUNT=0
    while [ $D_COUNT -lt 5 ]; do
        # Check 1: Container state & Mount accessibility
        MOUNT_OK=false
        if [ "$(docker inspect -f '{{.State.Running}}' "$DECYPHAR_CONTAINER" 2>/dev/null)" == "true" ] && \
           timeout 5s ls "$DECYPH_PATH/version.txt" > /dev/null 2>&1; then
            MOUNT_OK=true
        fi

        # Check 2: UI Responsiveness via host HTTP status
        UI_HTTP_CODE=$(curl -s -L -o /dev/null -w "%{http_code}" --max-time 5 "http://localhost:${DECYPHARR_PORT}/")
        UI_OK=false
        if [[ "$UI_HTTP_CODE" -eq 200 || "$UI_HTTP_CODE" -eq 303 ]]; then
            UI_OK=true
        fi

        if [[ "$MOUNT_OK" == "true" ]] && [[ "$UI_OK" == "true" ]]; then
            DEC_MOUNT_ALIVE=true
            log_step "Passed: Decypharr Mount and UI are UP."
            break
        fi
        
        log_step "WAITING: Decypharr mount/UI not ready (Attempt $((D_COUNT + 1))/5 | HTTP: $UI_HTTP_CODE)..."
        sleep 6
        ((D_COUNT++))
    done
    
    if [[ "$DEC_MOUNT_ALIVE" == "true" ]]; then
        if [[ "$DEC_STATE" != "UP" ]]; then
            DEC_STATE="UP"
            DEC_START_TS=$(date +%s)
        fi
    else
        log_step "[!] Decypharr failed checks (Mount or UI unresponsive). Restarting container..."
        docker restart "$DECYPHAR_CONTAINER" > /dev/null 2>&1
        if [[ "$DEC_STATE" != "DOWN" ]]; then
            DEC_STATE="DOWN"
            DEC_START_TS=$(date +%s)
        fi
    fi
fi

# --- SECTION 3.0: NZBDAV RECOVERY & FUSE CLEANUP ---
if [[ "$NZB_MOUNT_ALIVE" == "false" ]]; then
    log_step "REBUILD: Initiating In-Place Rclone recovery..."
    
    # Force unmount stale points without stopping the foundation container
    grep -q "$MOUNT_PATH" /etc/mtab && umount -l "$MOUNT_PATH" > /dev/null 2>&1
    fuser -k ${RC_PORT}/tcp > /dev/null 2>&1
    
    # Prevents "CRITICAL: Fatal error: ... is not empty" race condition
    if [ -d "$MOUNT_PATH" ] && [ "$(ls -A "$MOUNT_PATH" 2>/dev/null)" ]; then
        log_step "WARN: Stray files found in $MOUNT_PATH (likely created by Arrs). Wiping for clean mount..."
        
        # Safely remove contents to clear the path for Rclone
        rm -rf "$MOUNT_PATH"/*
        
        if [ $? -eq 0 ]; then
            log_step "SUCCESS: Target folder cleared."
        else
            log_step "ERROR: Could not clear $MOUNT_PATH. Rclone may fail."
        fi
    fi
    
    sleep 2

    RC_ARGS="--rc --rc-addr ${RC_IP}:${RC_PORT} --rc-user ${RC_USER} --rc-pass ${RC_PASS}"
    LAUNCHER="taskset -c $CPU_PIN"

    log_step "Launching Rclone Mount..."
    nohup $LAUNCHER rclone mount "$REMOTE_NAME" "$MOUNT_PATH" \
      --config "$RCLONE_CONF" --vfs-cache-mode "$VFS_MODE" --cache-dir "$VFS_CACHE_DIR" --vfs-cache-max-age "$VFS_CACHE_AGE" \
      --vfs-cache-max-size "$VFS_CACHE_SIZE" --vfs-read-ahead "$VFS_READ_AHEAD" --vfs-read-chunk-size-limit "$VFS_CHUNK_LIMIT" \
      --buffer-size "$RAM_BUFFER" --vfs-read-chunk-size "$CHUNK_START" \
      --dir-cache-time "$CACHE_TIME" \
      --uid 99 --gid 100 --umask 000 \
      --no-modtime --no-checksum --poll-interval 0 --links --use-cookies --allow-other \
      $RC_ARGS --log-level NOTICE --log-file "$LOG_FILE" > /dev/null 2>&1 &
          
    disown $!

    # --- SECTION 3.1: POST-FIX STABILIZATION ---    
    COUNT=0
    while [ $COUNT -lt 5 ]; do
        if timeout 5s ls "$VALIDATION_FILE" > /dev/null 2>&1; then
            log_step "SUCCESS: Mount stabilized."
            send_notification "Mount Success" "NzbDAV mount restored." "normal"
            NZB_STATE="UP"
            NZB_START_TS=$(date +%s)
            NZB_MOUNT_ALIVE=true
            break
        fi
        log_step "WAITING: Mount stabilizing (Attempt $((COUNT + 1))/5)..."
        sleep 6
        ((COUNT++))
    done
fi

if [[ "$NZB_MOUNT_ALIVE" == "false" ]]; then
    log_step "[ABORT] Mount recovery failed. Exiting."
    exit 1
fi

# --- SAVE STATE ---
{
    echo "NZB_STATE=\"$NZB_STATE\""
    echo "NZB_START_TS=\"$NZB_START_TS\""
    echo "DEC_STATE=\"$DEC_STATE\""
    echo "DEC_START_TS=\"$DEC_START_TS\""
} > "$STATE_FILE"

# --- SECTION 4.0: RESTORATION (AUTO-HEAL) ---
log_step "RESTORATION: Ensuring all containers are active..."
if [[ "$NZB_MOUNT_ALIVE" == "true" ]]; then
    for container in $CONTAINERS; do
        if [ "$(docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null)" != "true" ]; then
            log_step "Restoring $container..."
            docker start "$container" > /dev/null 2>&1
        fi
    done
    
    # Passive nudge for Decypharr
    if [[ -n "$DECYPHAR_CONTAINER" ]]; then
        if [[ "$DEC_MOUNT_ALIVE" == "false" ]]; then
             log_step "NzbDAV is UP, but Decypharr is stalled. Nudging container..."
             docker start "$DECYPHAR_CONTAINER" > /dev/null 2>&1
        fi
    fi
else
    log_step "[ABORT] Restoration skipped. Primary mount is offline."
fi

# --- SECTION 4.5: VFS CACHE SMART PRUNE ---
if [[ -d "$VFS_CACHE_DIR/vfs" ]]; then
    # Extract numerical target percentage (e.g., 85% -> 85)
    TARGET_UTIL_PCT="${CACHE_DRIVE_MAX_UTILISATION%%%}"
    
    # Get current drive utilisation percentage for the cache directory
    CURRENT_UTIL_PCT=$(df -P "$VFS_CACHE_DIR" | awk 'NR==2 {print $5}' | tr -d '%')
    CURRENT_UTIL_PCT=${CURRENT_UTIL_PCT:-0}

    if [ "$CURRENT_UTIL_PCT" -ge "$TARGET_UTIL_PCT" ]; then
        log_step "WARN: Cache drive utilisation (${CURRENT_UTIL_PCT}%) reached or exceeded target limit (${TARGET_UTIL_PCT}%). Initiating smart prune..."
        
        # Stream files sorted by access time (oldest first) and delete until utilisation is below target
        find "$VFS_CACHE_DIR/vfs" -type f -printf "%A@ %p\n" 2>/dev/null | sort -n 2>/dev/null | cut -d' ' -f2- 2>/dev/null | while read -r filepath; do
            if [ -f "$filepath" ]; then
                rm -f "$filepath" 2>/dev/null
                
                # Check current drive utilisation after deletion
                CHECK_UTIL_PCT=$(df -P "$VFS_CACHE_DIR" | awk 'NR==2 {print $5}' | tr -d '%')
                CHECK_UTIL_PCT=${CHECK_UTIL_PCT:-0}
                
                if [ "$CHECK_UTIL_PCT" -lt "$TARGET_UTIL_PCT" ]; then
                    log_step "SUCCESS: Cache drive utilisation pruned down to ${CHECK_UTIL_PCT}% (below ${TARGET_UTIL_PCT}% limit)."
                    break
                fi
            fi
        done
        
        # Clean up any leftover empty directories inside vfs
        find "$VFS_CACHE_DIR/vfs" -type d -empty -delete 2>/dev/null
    fi
fi

# --- SECTION 5.0: FINAL SUMMARY ---
log_step "FINALIZING: Generating summary report..."
[ -f "$STATE_FILE" ] && source "$STATE_FILE"

VFS_HUMAN_SIZE=$(du -sh "$VFS_CACHE_DIR" | cut -f1)
VFS_BYTE_SIZE=$(du -s "$VFS_CACHE_DIR" | cut -f1)

# Convert VFS_CACHE_SIZE to bytes
VAL=${VFS_CACHE_SIZE%[A-Z]}
UNIT=${VFS_CACHE_SIZE#$VAL}
case $UNIT in
    G) MAX_CACHE_KB=$((VAL * 1024 * 1024)) ;;
    M) MAX_CACHE_KB=$((VAL * 1024)) ;;
    *) MAX_CACHE_KB=$VAL ;;
esac

VFS_PERC=$(awk "BEGIN {printf \"%.1f\", ($VFS_BYTE_SIZE/$MAX_CACHE_KB)*100}")
RAM_TOTAL=$(grep MemTotal /proc/meminfo | awk '{print $2}')
RAM_FREE=$(grep MemAvailable /proc/meminfo | awk '{print $2}')
RAM_PERC=$(awk "BEGIN {printf \"%.1f\", (1-($RAM_FREE/$RAM_TOTAL))*100}")

calculate_duration() {
    local ts=${1:-$(date +%s)}
    local diff=$(($(date +%s) - $ts))
    local days=$((diff / 86400))
    local hours=$(( (diff % 86400) / 3600 ))
    local mins=$(( (diff % 3600) / 60 ))
    [ $days -gt 0 ] && echo "${days}d ${hours}h ${mins}m" || ([ $hours -gt 0 ] && echo "${hours}h ${mins}m" || echo "${mins}m")
}

NZB_TIME=$(calculate_duration $NZB_START_TS)

if [[ -n "$DECYPHAR_CONTAINER" ]]; then
    DEC_TIME=$(calculate_duration $DEC_START_TS)
    DEC_DISPLAY="${DEC_STATE} (${DEC_TIME})"
else
    DEC_DISPLAY="DISABLED"
fi

log_step ""
log_step "Status Summary:"
log_step "NzbDAV ${NZB_STATE} (${NZB_TIME}) : Decypharr ${DEC_DISPLAY} | VFS Cache ${VFS_HUMAN_SIZE} (${VFS_PERC}%) | RAM Use: ${RAM_PERC}%"
log_step "--------------------------------------------------------------------------------------"
log_step "STATUS: All Systems Operational."
exit 0
