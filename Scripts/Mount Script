#!/bin/bash
##### ======================================================================================
##### SCRIPT: Rclone Heartbeat
##### VERSION: v1.0-RC2.0.33 (Flock Inherit Fix & Child FD Closure)
##### DESCRIPTION: Monitors containerized and host-side Rclone mounts.
##### ======================================================================================

##### --------------------------------------------------------------------------------------
##### 1. USER CONFIGURATION
##### --------------------------------------------------------------------------------------

##### --- SCRIPT SETTINGS ---
SCRIPT_VERSION="v1.0-RC2.0.33"
STATE_FILE="/mnt/cache/appdata/other/scripts/rclone/prime_state.db"
LOG_FILE="/mnt/cache/appdata/other/scripts/rclone/rclone_mount.log"
FORCE_RESET="N"

##### --- REQUIRED SETTINGS ---
REMOTE_NAME="nzbdav:"                                                                           # Rclone remote name including colon
RCLONE_CONF="/boot/config/plugins/rclone/.rclone.conf"
MOUNT_PATH="/mnt/cache/streaming/nzbdav"                                                         # full path to where remote should be mounted
MEDIA_PATH="/mnt/cache/media"
VFS_CACHE_DIR="/mnt/samsung/streaming_cache/nzbdav"                                            # Path for rclone cache files
VFS_CACHE_SIZE="100G"                                                                           # Maximum size of the VFS cache
CACHE_DRIVE_SIZE="250G"
VFS_CACHE_AGE="2d"
VFS_READ_AHEAD="512M"
VFS_CHUNK_LIMIT="1024M"
VFS_MODE="off"                                                                                  # --vfs-cache-mode mode
CHUNK_START="8M"
RAM_BUFFER="512M"
CACHE_TIME="30d"

##### --- OPTIONAL MOUNT SETTINGS ---
DECYPH_PATH="/mnt/cache/streaming/decypharr"                                                     # Location of your Decypharr mount
RC_IP="0.0.0.0"                                                                                 # Bind to all interfaces for Docker access
RC_PORT="5573"                                                                                   # NzbDAV remote control port
RC_PORT_DEC="5572"                                                                               # Decypharr remote control port
RC_USER="your_username"
RC_PASS="your_password"
CPU_PIN="4,5,6,7,20,21,22,23"                                                                   # Cores to lock rclone to

CONNECTION_TIMEOUT="15s"
TIMEOUT="45s"
LOW_LEVEL_RETRIES="3"

##### --- DOCKER & COMPOSE SETTINGS ---
NZBDAV_CONTAINER="nzbdav"
DECYPHAR_CONTAINER="Decypharr"
USE_COMPOSE="true"

CONTAINERS="autopulse byparr prowlarr postgresql16 autoheal plex emby tautulli seerr wizarr radarr sonarr lidarr posterizarr kometa chaptarr komga silo_postgres silo_redis silo_minio silo_meilisearch silo_ollama silo_whisper silo_server"

declare -A CONTAINER_PROJECTS
CONTAINER_PROJECTS=(
    ["postgresql16"]="/mnt/cache/appdata/projects/12-15"
    ["autoheal"]="/mnt/cache/appdata/projects/0"
    ["autopulse"]="/mnt/cache/appdata/projects/0"
    ["bazarr"]="/mnt/cache/appdata/projects/12-15"
    ["chaptarr"]="/mnt/cache/appdata/projects/12-15"
    ["houndarr"]="/mnt/cache/appdata/projects/12-15"
    ["lidarr"]="/mnt/cache/appdata/projects/12-15"
    ["prowlarr"]="/mnt/cache/appdata/projects/12-15"
    ["radarr"]="/mnt/cache/appdata/projects/12-15"
    ["sonarr"]="/mnt/cache/appdata/projects/12-15"
    ["plex"]="/mnt/cache/appdata/projects/plex"
    ["emby"]="/mnt/cache/appdata/projects/plex"
    ["komga"]="/mnt/cache/appdata/projects/plex"
    ["posterizarr"]="/mnt/cache/appdata/projects/plex"
    ["kometa"]="/mnt/cache/appdata/projects/plex"
    ["tautulli"]="/mnt/cache/appdata/projects/plex"
    ["seerr"]="/mnt/cache/appdata/projects/plex"
    ["wizarr"]="/mnt/cache/appdata/projects/0"
    ["silo_postgres"]="/mnt/cache/appdata/projects/silo"
    ["silo_redis"]="/mnt/cache/appdata/projects/silo"
    ["silo_minio"]="/mnt/cache/appdata/projects/silo"
    ["silo_meilisearch"]="/mnt/cache/appdata/projects/silo"
    ["silo_ollama"]="/mnt/cache/appdata/projects/silo"
    ["silo_whisper"]="/mnt/cache/appdata/projects/silo"
    ["silo_server"]="/mnt/cache/appdata/projects/silo"
)

##### --------------------------------------------------------------------------------------
##### 2. MAIN SCRIPT - DO NOT EDIT BELOW HERE!
##### --------------------------------------------------------------------------------------
log_step() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" ; }

send_notification() {
    local subject="$1"
    local message="$2"
    local importance="$3"
    /usr/local/emhttp/webGui/scripts/notify -e "Rclone Heartbeat" -s "$subject" -d "$message" -i "$importance" 2>/dev/null || true
}

##### --- SECTION 2.1: STARTUP PREPARATION & FLOCK ---
if [[ "$*" == *"-f"* ]] || [[ "$*" == *"--force"* ]]; then
    FORCE_RESET="Y"
fi

LOCKFILE="/var/run/rclone_mount_heartbeat.lock"

# Handle Hard Reset termination quietly (redirect stdout and stderr to prevent PID dumps in log)
if [[ "$FORCE_RESET" == "Y" ]]; then
    log_step "[FORCE RESET] Terminating any existing/stuck Heartbeat instances..."
    pkill -9 -f "rclone_mount_heartbeat" >/dev/null 2>&1 || true
    fuser -k -9 "$LOCKFILE" >/dev/null 2>&1 || true
    sleep 1
fi

# Register exit cleanup trap to release flock and close descriptor
cleanup() {
    flock -u 9 2>/dev/null || true
    exec 9>&- 2>/dev/null || true
}
trap cleanup EXIT INT TERM HUP

# Acquire flock on lockfile descriptor
exec 9>"$LOCKFILE"
if ! flock -n 9; then
    log_step "[ABORT] Script is already running (PID $(cat "$LOCKFILE" 2>/dev/null)). Exiting."
    exit 1
fi

# Store active PID in lockfile descriptor
echo $$ >&9

log_step "VALIDATING: Script configuration and environment..."
log_step "---------------------------------------------------"
log_step "[CONFIG SUMMARY]"
log_step "Script Version: $SCRIPT_VERSION"
log_step "Mode: $( [[ "$FORCE_RESET" == "Y" ]] && echo "HARD RESET (-f)" || echo "HEARTBEAT MONITOR" )"
log_step "Rclone Remote: $REMOTE_NAME"
log_step "State File: $STATE_FILE"
log_step ""
log_step "[DOCKER SETTINGS]"
log_step "NzbDAV Container: $NZBDAV_CONTAINER"
log_step "Decypharr Container: $DECYPHAR_CONTAINER"
log_step "---------------------------------------------------"

##### --- SECTION 2.2: ENVIRONMENTAL READINESS ---
mkdir -p "$(dirname "$STATE_FILE")"
mkdir -p "$(dirname "$LOG_FILE")"
mkdir -p "$VFS_CACHE_DIR"

##### ======================================================================================
##### BRANCH A: FORCED HARD RESET MODE (-f)
##### ======================================================================================
if [[ "$FORCE_RESET" == "Y" ]]; then
    log_step "======================================================================================"
    log_step "HARD RESET INITIATED: Stopping client containers, tearing down mounts, starting core containers."
    log_step "======================================================================================"

    # 1. STOP ALL CLIENT CONTAINERS
    log_step "[RESET 1/4] Stopping all client application containers..."
    for container in $CONTAINERS; do
        if [[ "$container" != "$NZBDAV_CONTAINER" ]] && [[ "$container" != "$DECYPHAR_CONTAINER" ]]; then
            if [ "$(docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null)" == "true" ]; then
                log_step "  -> Stopping container: $container..."
                docker stop "$container" >/dev/null 2>&1 || true
            fi
        fi
    done
    log_step "  -> All client containers stopped."

    # 2. TEAR DOWN NZBDAV HOST MOUNT & CLEAR RCLONE PROCESSES (DO NOT REMOUNT)
    log_step "[RESET 2/4] Unmounting NzbDAV host path ($MOUNT_PATH) and clearing host rclone processes..."
    fusermount -uz "$MOUNT_PATH" > /dev/null 2>&1 || true
    umount -l "$MOUNT_PATH" > /dev/null 2>&1 || true
    fuser -k "${RC_PORT}/tcp" > /dev/null 2>&1 || true
    pkill -9 -f "rclone mount $REMOTE_NAME" > /dev/null 2>&1 || true

    if [ -d "$MOUNT_PATH" ] && [ "$(ls -A "$MOUNT_PATH" 2>/dev/null)" ]; then
        log_step "  -> Clearing stray files in $MOUNT_PATH..."
        rm -rf "$MOUNT_PATH"/* 2>/dev/null || true
    fi
    log_step "  -> NzbDAV host mount successfully torn down and kept DOWN."

    # 3. ENSURE NZBDAV & DECYPHARR CONTAINERS ARE UP
    log_step "[RESET 3/4] Ensuring Core Containers ($NZBDAV_CONTAINER & $DECYPHAR_CONTAINER) are UP..."

    log_step "  -> Restarting $NZBDAV_CONTAINER container..."
    docker restart "$NZBDAV_CONTAINER" > /dev/null 2>&1 || docker start "$NZBDAV_CONTAINER" > /dev/null 2>&1

    log_step "  -> Restarting $DECYPHAR_CONTAINER container..."
    docker restart "$DECYPHAR_CONTAINER" > /dev/null 2>&1 || docker start "$DECYPHAR_CONTAINER" > /dev/null 2>&1

    log_step "  -> Waiting 8 seconds for core container engines to initialize..."
    sleep 8

    # 4. AUDIT DECYPHARR CONTAINER STATUS
    log_step "[RESET 4/4] Verifying Decypharr responsiveness..."
    DECYPHARR_PORT="8282"
    DEC_STATE="DOWN"
    DEC_START_TS=$(date +%s)

    if [ "$(docker inspect -f '{{.State.Running}}' "$DECYPHAR_CONTAINER" 2>/dev/null)" == "true" ]; then
        UI_HTTP_CODE=$(curl -s -L -o /dev/null -w "%{http_code}" --max-time 5 "http://localhost:${DECYPHARR_PORT}/" || echo "000")
        if [[ "$UI_HTTP_CODE" -eq 200 || "$UI_HTTP_CODE" -eq 303 ]]; then
            DEC_STATE="UP"
            log_step "  -> Decypharr Container & UI are ONLINE (HTTP $UI_HTTP_CODE)."
        else
            log_step "  -> WARNING: Decypharr container running, UI returned HTTP $UI_HTTP_CODE."
            DEC_STATE="UP"
        fi
    else
        log_step "  -> ERROR: Decypharr container failed to start."
    fi

    NZB_STATE="DOWN"
    NZB_START_TS=$(date +%s)

    # SAVE STATE
    {
        echo "NZB_STATE="$NZB_STATE""
        echo "NZB_START_TS="$NZB_START_TS""
        echo "DEC_STATE="$DEC_STATE""
        echo "DEC_START_TS="$DEC_START_TS""
    } > "$STATE_FILE"

    log_step "======================================================================================"
    log_step "HARD RESET SUMMARY:"
    log_step "  - NzbDAV Container ($NZBDAV_CONTAINER): UP"
    log_step "  - Decypharr Container ($DECYPHAR_CONTAINER): $DEC_STATE"
    log_step "  - NzbDAV Host Mount ($MOUNT_PATH): DOWN (Unmounted)"
    log_step "  - Client Containers: ALL DOWN"
    log_step "STATUS: Hard Reset Complete."
    log_step "======================================================================================"
    exit 0
fi

##### ======================================================================================
##### BRANCH B: STANDARD HEARTBEAT MONITOR MODE
##### ======================================================================================

##### --- SECTION 2.3: FOUNDATION CHECK ---
log_step "Ensuring Core services are active..."
STARTED_ANY=false
for container in "$NZBDAV_CONTAINER" "$DECYPHAR_CONTAINER"; do
    if [[ -n "$container" ]]; then
        if [ "$(docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null)" != "true" ]; then
            log_step "Starting $container..."
            docker start "$container" > /dev/null 2>&1
            STARTED_ANY=true
        fi
    fi
done
if [ "$STARTED_ANY" == "true" ]; then
    log_step "Waiting 8 seconds for containerized rclone storage layers to settle..."
    sleep 8
fi

##### --- SECTION 2.4: NZBDAV MOUNT AUDIT ---
[ -f "$STATE_FILE" ] && source "$STATE_FILE"
VALIDATION_FILE="$MOUNT_PATH/README"
log_step "CHECKING: NzbDAV Mount integrity..."
NZB_MOUNT_ALIVE=false

if [ "$(docker inspect -f '{{.State.Running}}' "$NZBDAV_CONTAINER" 2>/dev/null)" == "true" ] && grep -q "$MOUNT_PATH" /etc/mtab; then
    N_COUNT=0
    while [ $N_COUNT -lt 5 ]; do
        if timeout 5s stat "$VALIDATION_FILE" > /dev/null 2>&1; then
            NZB_MOUNT_ALIVE=true
            log_step "SUCCESS: NzbDAV Mount is ONLINE."
            break
        fi
        log_step "WAITING: NzbDAV mount stalling (Attempt $((N_COUNT + 1))/5)..."
        sleep 6
        ((N_COUNT++))
    done
else
    log_step "[!] NzbDAV process/mount missing."
fi

### Update NzbDAV State
if [[ "$NZB_MOUNT_ALIVE" == "true" ]]; then
    if [[ "$NZB_STATE" != "UP" ]]; then
        NZB_STATE="UP"
        NZB_START_TS=$(date +%s)
    fi
else
    log_step "[!] Failed: NzbDAV is DOWN."
    send_notification "Mount Down" "NzbDAV mount failure detected at $MOUNT_PATH" "alert"
    if [[ "$NZB_STATE" != "DOWN" ]]; then
        NZB_STATE="DOWN"
        NZB_START_TS=$(date +%s)
    fi
fi

##### --- SECTION 2.5: DECYPHARR MOUNT & UI AUDIT ---
DEC_MOUNT_ALIVE=false
DEC_VALIDATION_FILE="$DECYPH_PATH/version.txt"
DECYPHARR_PORT="8282"

if [[ -n "$DECYPH_PATH" ]] && [[ -n "$DECYPHAR_CONTAINER" ]]; then
    log_step "CHECKING: Decypharr Mount & UI responsiveness..."
    D_COUNT=0
    while [ $D_COUNT -lt 5 ]; do
        MOUNT_OK=false
        if [ "$(docker inspect -f '{{.State.Running}}' "$DECYPHAR_CONTAINER" 2>/dev/null)" == "true" ] &&            grep -q "$DECYPH_PATH" /etc/mtab &&            timeout 5s stat "$DEC_VALIDATION_FILE" > /dev/null 2>&1; then
            MOUNT_OK=true
        fi

        UI_HTTP_CODE=$(curl -s -L -o /dev/null -w "%{http_code}" --max-time 5 "http://localhost:${DECYPHARR_PORT}/" || echo "000")
        UI_OK=false
        if [[ "$UI_HTTP_CODE" -eq 200 || "$UI_HTTP_CODE" -eq 303 ]]; then
            UI_OK=true
        fi

        if [[ "$MOUNT_OK" == "true" ]] && [[ "$UI_OK" == "true" ]]; then
            DEC_MOUNT_ALIVE=true
            log_step "SUCCESS: Decypharr Mount and UI are ONLINE."
            break
        fi
        log_step "WAITING: Decypharr mount/UI not ready (Attempt $((D_COUNT + 1))/5 | HTTP: $UI_HTTP_CODE)..."
        sleep 6
        ((D_COUNT++))
    done

    if [[ "$DEC_MOUNT_ALIVE" == "true" ]]; then
        if [[ "$DEC_STATE" != "UP" ]]; then
            DEC_STATE="UP"
            DEC_START_TS=$(date +%s)
        fi
    else
        log_step "[!] Decypharr failed checks. Restarting container..."
        docker restart "$DECYPHAR_CONTAINER" > /dev/null 2>&1
        if [[ "$DEC_STATE" != "DOWN" ]]; then
            DEC_STATE="DOWN"
            DEC_START_TS=$(date +%s)
        fi
    fi
fi

##### --- SECTION 3.0: NZBDAV RECOVERY & FUSE CLEANUP ---
if [[ "$NZB_MOUNT_ALIVE" == "false" ]]; then
    log_step "REBUILD: Initiating Host-Side Rclone recovery for NzbDAV..."

    log_step "RESET: Stopping active client containers to release FUSE mount locks..."
    for container in $CONTAINERS; do
        if [ "$(docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null)" == "true" ]; then
            docker stop "$container" >/dev/null 2>&1 || true
        fi
    done

    log_step "REBUILD: Restarting NzbDAV backend container ($NZBDAV_CONTAINER)..."
    docker restart "$NZBDAV_CONTAINER" > /dev/null 2>&1
    sleep 8

    log_step "REBUILD: Executing FUSE-First lazy unmount on $MOUNT_PATH..."
    fusermount -uz "$MOUNT_PATH" > /dev/null 2>&1
    umount -l "$MOUNT_PATH" > /dev/null 2>&1

    log_step "REBUILD: Unlocking RC Port $RC_PORT & clearing orphaned rclone processes..."
    fuser -k "${RC_PORT}/tcp" > /dev/null 2>&1

    # Clear stray files in mount point folder if left unmounted
    if [ -d "$MOUNT_PATH" ] && [ "$(ls -A "$MOUNT_PATH" 2>/dev/null)" ]; then
        log_step "WARN: Stray files found in $MOUNT_PATH. Clearing for clean mount..."
        rm -rf "$MOUNT_PATH"/* 2>/dev/null || true
    fi

    # DYNAMIC RC ADDRESS (Uses RC_IP from settings)
    if [[ -n "$RC_USER" ]] && [[ -n "$RC_PASS" ]]; then
        RC_ARGS="--rc --rc-addr ${RC_IP}:${RC_PORT} --rc-user ${RC_USER} --rc-pass ${RC_PASS}"
    else
        RC_ARGS="--rc --rc-addr ${RC_IP}:${RC_PORT} --rc-no-auth"
    fi

    LAUNCHER="taskset -c $CPU_PIN"
    log_step "Launching Rclone Mount with RC listening on ${RC_IP}:${RC_PORT}..."
    nohup $LAUNCHER rclone mount "$REMOTE_NAME" "$MOUNT_PATH"         --config "$RCLONE_CONF"         --allow-other         --vfs-cache-mode "$VFS_MODE"         --vfs-cache-max-age "$VFS_CACHE_AGE"         --vfs-cache-max-size "$VFS_CACHE_SIZE"         --vfs-read-ahead "$VFS_READ_AHEAD"         --vfs-read-chunk-size "$CHUNK_START"         --vfs-read-chunk-size-limit "$VFS_CHUNK_LIMIT"         --buffer-size "$RAM_BUFFER"         --dir-cache-time "$CACHE_TIME"         --cache-dir "$VFS_CACHE_DIR"         --contimeout "$CONNECTION_TIMEOUT"         --timeout "$TIMEOUT"         --low-level-retries "$LOW_LEVEL_RETRIES"         --uid 99 --gid 100 --umask 000         --no-modtime --no-checksum --poll-interval 0 --links --use-cookies         $RC_ARGS --log-level NOTICE --log-file "$LOG_FILE" > /dev/null 2>&1 9>&- &
    disown $!

    # STABILIZATION RETRY LOOP
    COUNT=0
    while [ $COUNT -lt 5 ]; do
        if grep -q "$MOUNT_PATH" /etc/mtab && timeout 5s stat "$VALIDATION_FILE" >/dev/null 2>&1; then
            log_step "REBUILD: NzbDAV mount recovered successfully on host."
            send_notification "Mount Success" "NzbDAV mount restored." "normal"
            NZB_MOUNT_ALIVE=true
            NZB_STATE="UP"
            NZB_START_TS=$(date +%s)

            log_step "REBUILD: Launching asynchronous background priming..."
            (
                find $MEDIA_PATH '(' -type f -o -type l ')' -print > /tmp/media_symlinks.txt 2>/dev/null
                xargs -d '
' -a /tmp/media_symlinks.txt -P 64 -n 1000 stat -L >/dev/null 2>&1
                rm -f /tmp/media_symlinks.txt
                logger "Rclone Priming: Background library warming complete."
            ) 9>&- &
            break
        fi
        log_step "WAITING: Mount stabilizing (Attempt $((COUNT + 1))/5)..."
        sleep 6
        ((COUNT++))
    done

    if [[ "$NZB_MOUNT_ALIVE" == "false" ]]; then
        log_step "CRITICAL ERROR: Host-side rclone mount failed to re-initialize."
    fi
fi

##### --- SECTION 3.5: DECYPHARR RECOVERY ---
if [[ "$DEC_MOUNT_ALIVE" == "false" ]]; then
    log_step "REBUILD: Initiating Decypharr recovery..."
    log_step "REBUILD: Executing FUSE-First lazy unmount on $DECYPH_PATH..."
    fusermount -uz "$DECYPH_PATH" > /dev/null 2>&1
    umount -l "$DECYPH_PATH" > /dev/null 2>&1

    log_step "REBUILD: Restarting Decypharr container ($DECYPHAR_CONTAINER)..."
    docker restart "$DECYPHAR_CONTAINER" > /dev/null 2>&1
    sleep 8

    D_COUNT=0
    DEC_RECOVERED=false
    while [ $D_COUNT -lt 5 ]; do
        MOUNT_OK=false
        if [ "$(docker inspect -f '{{.State.Running}}' "$DECYPHAR_CONTAINER" 2>/dev/null)" == "true" ] &&            grep -q "$DECYPH_PATH" /etc/mtab &&            timeout 5s stat "$DEC_VALIDATION_FILE" > /dev/null 2>&1; then
            MOUNT_OK=true
        fi

        UI_HTTP_CODE=$(curl -s -L -o /dev/null -w "%{http_code}" --max-time 5 "http://localhost:${DECYPHARR_PORT}/" || echo "000")
        UI_OK=false
        if [[ "$UI_HTTP_CODE" -eq 200 || "$UI_HTTP_CODE" -eq 303 ]]; then
            UI_OK=true
        fi

        if [[ "$MOUNT_OK" == "true" ]] && [[ "$UI_OK" == "true" ]]; then
            DEC_RECOVERED=true
            log_step "REBUILD: Decypharr mount and UI recovered successfully."
            DEC_STATE="UP"
            DEC_START_TS=$(date +%s)
            DEC_MOUNT_ALIVE=true
            break
        fi
        log_step "WAITING: Decypharr mount/UI stabilizing (Attempt $((D_COUNT + 1))/5)..."
        sleep 6
        ((D_COUNT++))
    done

    if [[ "$DEC_RECOVERED" == "false" ]]; then
        log_step "[!] Decypharr failed to stabilize after restart."
        DEC_STATE="DOWN"
        DEC_START_TS=$(date +%s)
        DEC_MOUNT_ALIVE=false
    fi
fi

if [[ "$NZB_MOUNT_ALIVE" == "false" ]]; then
    log_step "[ABORT] Primary mount recovery failed. Exiting."
    exit 1
fi

##### --- SAVE STATE ---
{
    echo "NZB_STATE="$NZB_STATE""
    echo "NZB_START_TS="$NZB_START_TS""
    echo "DEC_STATE="$DEC_STATE""
    echo "DEC_START_TS="$DEC_START_TS""
} > "$STATE_FILE"

##### --- SECTION 4.0: RESTORATION (AUTO-HEAL) ---
log_step "RESTORATION: Ensuring all client applications are active..."
if [[ "$NZB_MOUNT_ALIVE" == "true" ]]; then
    for container in $CONTAINERS; do
        if [[ -n "$container" ]]; then
            RUNNING_STATE=$(docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null || echo "missing")
            if [ "$RUNNING_STATE" != "true" ]; then
                PROJECT_DIR="${CONTAINER_PROJECTS[$container]}"
                if [ -n "$PROJECT_DIR" ] && [ -f "$PROJECT_DIR/docker-compose.yml" ]; then
                    log_step "Restoring compose container: $container (project: $PROJECT_DIR)..."
                    (cd "$PROJECT_DIR" && docker compose up -d --no-deps "$container" > /dev/null 2>&1)
                    sleep 1
                elif [ "$RUNNING_STATE" != "missing" ]; then
                    log_step "Restoring standalone container: $container..."
                    docker start "$container" > /dev/null 2>&1
                    sleep 1
                fi
            fi
        fi
    done
else
    log_step "[ABORT] Client restoration skipped. Primary NzbDAV mount is offline."
fi

##### --- SECTION 5.0: FINAL SUMMARY ---
log_step "FINALIZING: Generating summary report..."
[ -f "$STATE_FILE" ] && source "$STATE_FILE"

calculate_duration() {
    local ts=${1:-$(date +%s)}
    local diff=$(($(date +%s) - ts))
    local days=$((diff / 86400))
    local hours=$(((diff % 86400) / 3600))
    local mins=$(((diff % 3600) / 60))
    [ $days -gt 0 ] && echo "${days}d ${hours}h ${mins}m" || ([ $hours -gt 0 ] && echo "${hours}h ${mins}m" || echo "${mins}m")
}

NZB_TIME=$(calculate_duration $NZB_START_TS)
if [[ -n "$DECYPHAR_CONTAINER" ]]; then
    DEC_TIME=$(calculate_duration $DEC_START_TS)
    DEC_DISPLAY="${DEC_STATE} (${DEC_TIME})"
else
    DEC_DISPLAY="DISABLED"
fi

log_step ""
log_step "Status Summary:"
log_step "NzbDAV ${NZB_STATE} (${NZB_TIME}) | Decypharr ${DEC_DISPLAY}"
log_step "--------------------------------------------------------------------------------------"
log_step "STATUS: All Systems Operational."
exit 0
